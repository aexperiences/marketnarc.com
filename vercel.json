{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/narcs/open",
      "missing": [
        {
          "type": "query",
          "key": "unlocked"
        }
      ],
      "destination": "/narcs/thenarc-app",
      "permanent": false
    },
    {
      "source": "/narcs/billnarc-app",
      "destination": "/narcs/thenarc-app#bill",
      "permanent": false
    },
    {
      "source": "/narcs/homenarc-app",
      "destination": "/narcs/thenarc-app#home",
      "permanent": false
    },
    {
      "source": "/narcs/pawnarc-app",
      "destination": "/narcs/thenarc-app#paw",
      "permanent": false
    },
    {
      "source": "/narcs/taxnarc-app",
      "destination": "/narcs/thenarc-app#tax",
      "permanent": false
    },
    {
      "source": "/narcs/collectionsnarc-app",
      "destination": "/narcs/thenarc-app#collections",
      "permanent": false
    },
    {
      "source": "/open",
      "missing": [
