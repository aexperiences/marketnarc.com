{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/narcs/thenarc",
      "destination": "/narcs/thenarc-app",
      "permanent": false
    },
    {
      "source": "/narcs/narc",
      "destination": "/narcs/thenarc-app",
      "permanent": false
    },
    {
      "source": "/narcs/pricing",
      "destination": "/narcs/thenarc-pricing",
      "permanent": false
    },
    {
      "source": "/narcs/billnarc",
      "destination": "/narcs/thenarc-app#bill",
      "permanent": false
    },
    {
      "source": "/narcs/homenarc",
      "destination": "/narcs/thenarc-app#home",
      "permanent": false
    },
    {
      "source": "/narcs/pawnarc",
      "destination": "/narcs/thenarc-app#paw",
      "permanent": false
    },
    {
      "source": "/narcs/taxnarc",
      "destination": "/narcs/thenarc-app#tax",
      "permanent": false
    },
    {
      "source": "/narcs/collectionsnarc",
      "destination": "/narcs/thenarc-app#collections",
      "permanent": false
    },
    {
      "source": "/narcs/benefits",
      "destination": "/narcs/thenarc-app#benefits",
      "permanent": false
    },
    {
      "source": "/narcs/benefitsnarc",
      "destination": "/narcs/thenarc-app#benefits",
      "permanent": false
    },
    {
      "source": "/thenarc",
      "destination": "/narcs/thenarc-app",
      "permanent": false
    },
    {
      "source": "/narc",
      "destination": "/narcs/thenarc-app",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/narcs/thenarc-pricing",
      "permanent": false
    },
    {
      "source": "/benefits",
      "destination": "/narcs/thenarc-app#benefits",
      "permanent": false
    },
    {
      "source": "/benefitsnarc",
      "destination": "/narcs/thenarc-app#benefits",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/narcs",
      "destination": "/"
    },
    {
      "source": "/narcs/",
      "destination": "/"
    },
    {
      "source": "/narcs/:path*",
      "destination": "/:path*"
    }
  ]
}
